# Copy to .env and fill in. Never commit .env.

# --- Google Cloud / Vertex AI ---------------------------------------------
GCP_PROJECT=your-gcp-project-id
# `global` serves gemini-3.8-flash. A single region like us-central1 may not.
GCP_LOCATION=global

# Verify these are live in your project: python -m scripts.check_models
GEN_MODEL=gemini-3.8-flash
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# Local auth uses Application Default Credentials:
#   gcloud auth application-default login
# On Cloud Run this is the attached service account (Vertex AI User only).

# --- MongoDB Atlas ---------------------------------------------------------
# Atlas -> Connect -> Drivers -> Python. Put the password in here, not in code.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=socratic
