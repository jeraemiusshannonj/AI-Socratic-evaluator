.env
.venv/
venv/
__pycache__/
*.pyc
chroma_db/
.idea/
.vscode/

# Local interaction logs. These were committed previously with ~112 rows of
# real session data; they are now history-only and should not come back.
*.db
*.sqlite
*.sqlite3

# Eval artifacts. eval/results/ is deliberately NOT ignored: the README
# quotes those numbers, and a reader who can open the raw report has a way
# to check them. Large intermediate dumps still are.
*.jsonl.gz

# Corpus build. Upstream clones and the converted markdown are both
# reproducible from corpus/sources.py via `python -m scripts.build_corpus`,
# so the repository carries the mapping and the converter rather than a copy
# of three upstream documentation projects.
corpus/_sources/
corpus/_build/

# patch files produced while iterating; never part of the project
*.patch
