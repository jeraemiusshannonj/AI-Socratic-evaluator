From 6593350bcca387f053b05fc20a7993fe8810cd12 Mon Sep 17 00:00:00 2001
From: Jeraemius Shannon <shannon99946@gmail.com>
Date: Tue, 27 Oct 2026 17:36:28 -0500
Subject: [PATCH] Add future annotations to config so it imports on Python 3.9

---
 socratic/config.py | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/socratic/config.py b/socratic/config.py
index 74fc459..2c39e09 100644
--- a/socratic/config.py
+++ b/socratic/config.py
@@ -6,6 +6,12 @@ in one place and verify against your own project with:
     python -m scripts.check_models
 """
 
+# Required: this module is imported by everything, including on Python 3.9
+# where `float | None` in an annotation is evaluated at import time and
+# raises TypeError. Without it, adding a union here breaks every script in
+# the project at once, which is exactly what happened.
+from __future__ import annotations
+
 import os
 
 from dotenv import load_dotenv
