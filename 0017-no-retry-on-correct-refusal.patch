--- a/socratic/tutor.py
+++ b/socratic/tutor.py
@@ -115,6 +115,10 @@ class Evaluation:
   # means the model invented a source, which is the thing worth catching.
   invalid_citations: list[str] = field(default_factory=list)
   passages: list[Passage] = field(default_factory=list)
